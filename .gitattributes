# Keep LF line endings in the repo and in every working copy, on every OS.
# Hooks and scripts run on Windows, macOS and Linux, so they must not change
# with the user's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
